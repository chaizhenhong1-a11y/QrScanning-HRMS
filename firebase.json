{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    },
    {
      "source": "functions_claims",
      "codebase": "claims",
      "runtime": "nodejs22"
    }
  ],
  "extensions": {
    "firestore-send-email": "firebase/firestore-send-email@0.2.10"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
